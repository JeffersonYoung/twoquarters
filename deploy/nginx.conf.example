# Put into your existing HTTPS server block after configuring your real domain and certificate.
# APP_ORIGIN must exactly match the browser's https://hostname[:port].
client_max_body_size 250m;
client_body_timeout 600s;
location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;
    # Stream uploads directly; avoid a second temporary original in proxy storage.
    proxy_request_buffering off;
}
# Do not expose port 3000 publicly or proxy arbitrary third-party origins here.
