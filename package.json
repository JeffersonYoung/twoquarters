{
  "name": "twoquarters-selfhosted",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "eslint src --max-warnings 0",
    "start": "node server/index.mjs",
    "admin:init": "node scripts/admin.mjs",
    "samples:init": "node scripts/init-samples.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "prebuild": "node scripts/prepare-static-images.mjs",
    "images:prepare": "node scripts/prepare-images.mjs",
    "db:init": "node scripts/database.mjs init --maintenance",
    "db:check": "node scripts/database.mjs check",
    "db:migrate": "node scripts/database.mjs migrate --maintenance"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "playwright": "^1.54.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
